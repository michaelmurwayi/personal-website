# Application
VITE_APP_NAME=React SPA Core
VITE_PORT=5173

# API backend
VITE_API_BASE_URL=http://localhost:4000
VITE_API_PROXY_PATH=/api

# RTK Query caching (seconds). Controls how long fetched data is retained in
# memory after the last component unmounts (`keepUnusedDataFor`).
VITE_API_CACHE_TTL_SECONDS=60

# Build
VITE_BUILD_SOURCEMAP=true
